<persistence xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd" 
             version="3.1"> 
  <persistence-unit name="DefaultPersistenceUnit">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.onmicrosoft.liguosworld.example.jpa.model.Libro</class>
    <class>com.onmicrosoft.liguosworld.example.jpa.model.Autore</class>
    <class>com.onmicrosoft.liguosworld.example.jpa.model.Editore</class>
    <properties>
        <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
        <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/corso_jpa?useSSL=false&amp;allowPublicKeyRetrieval=true"/>
        <property name="jakarta.persistence.jdbc.user" value="raffaello"/>
        <property name="jakarta.persistence.jdbc.password" value="AclS33queL."/>
        <property name="hibernate.hbm2ddl.auto" value="update"/>
        <property name="hibernate.format_sql" value="true"/> 
        <property name="hibernate.highlight_sql" value="true"/> 
        <property name="hibernate.show_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
<!-- persistence.xml -->
<!-- This file is used to configure the persistence unit for JPA. It specifies the provider,
     the classes to be managed, and the database connection properties. -->
<!-- The persistence unit is named "DefaultPersistenceUnit" and uses the Hibernate JPA provider.
     It includes classes for managing books, authors, publishers, categories, loans, and users. -->
<!-- The database connection is configured to use MySQL with the specified URL, user, and password.
     The Hibernate properties include automatic schema updates and SQL logging. -->
<!-- This configuration is essential for the JPA implementation to interact with the database
     and manage the entity lifecycle. -->
<!-- The persistence.xml file is typically located in the META-INF directory of the classpath. -->
<!-- It is used by the JPA provider to bootstrap the persistence context and manage entity instances. -->
<!-- The properties defined in this file can be customized based on the application's requirements,
     such as changing the database connection details or Hibernate settings. -->
<!-- The use of "jakarta.persistence" namespace indicates that this configuration is compatible with
     Jakarta EE 9 and later versions, which have transitioned from the "javax" namespace. -->
<!-- This file is crucial for setting up the JPA environment and ensuring that the application can
     perform CRUD operations on the defined entities. -->
<!-- The classes specified in the persistence unit must be annotated with JPA annotations such as
     @Entity, @Table, @Id, etc., to define their mapping to the database tables and columns.
     This allows the JPA provider to manage the entities correctly and perform operations like
     persisting, querying, and deleting them in the database. -->
<!-- The "hibernate.hbm2ddl.auto" property set to "update" allows Hibernate to automatically
     update the database schema based on the entity mappings. This is useful during development
     but should be used with caution in production environments, as it may lead to data loss
     if not handled properly. Other options include "create", "create-drop", and "validate",
     which control how the schema is managed. -->
<!-- The "hibernate.show_sql" property set to "true" enables logging of SQL statements generated
     by Hibernate, which can be helpful for debugging and understanding the interactions with the database.
     This can be turned off in production environments to reduce logging overhead. -->
<!-- The persistence.xml file is a key component in JPA applications, providing the necessary
     configuration for the persistence context and entity management. It allows developers to define
     how the application interacts with the underlying database and manages entity lifecycles. -->
<!-- The configuration can be extended with additional properties or custom settings as needed,
     such as enabling caching, specifying transaction management strategies, or integrating with
     other frameworks like Spring or CDI. -->
<!-- The persistence unit can also be named differently based on the application's requirements,
     allowing for multiple persistence units within the same application if needed. This can be useful
     for separating different data sources or managing different sets of entities with distinct configurations. -->
<!-- The persistence.xml file is essential for JPA applications to function correctly,
     as it provides the necessary metadata for the JPA provider to initialize and manage the persistence context
     and entity instances. It is typically included in the application's classpath during runtime,
     allowing the JPA provider to discover and use it when the application starts. -->
